/* Colores corporativos basados en color.png */
:root {
    --amarillo: #f9c900;
    --verde: #05b700;
    --azul-oscuro: #094062;
    --fondo: #f4f4f9;
}

body {
    font-family: Arial, sans-serif;
    background-color: var(--fondo);
    margin: 0;
    padding: 0;
    color: var(--azul-oscuro);
}

/* Login */
#login-container {
    width: 300px;
    margin: 100px auto;
    padding: 30px;
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    text-align: center;
    border-top: 5px solid var(--verde);
}

.logo { width: 120px; margin-bottom: 20px; }
.logo-small { height: 40px; vertical-align: middle; }

input {
    width: 90%;
    padding: 10px;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 4px;
}

button {
    width: 100%;
    padding: 10px;
    background-color: var(--azul-oscuro);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
}
button:hover { background-color: var(--verde); }

/* Dashboard */
header {
    background-color: var(--azul-oscuro);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 30px;
}
header h1 { margin: 0; font-size: 20px; color: var(--amarillo); }
.btn-logout { width: auto; background-color: #d9534f; margin-left: 15px;}

nav {
    background-color: white;
    padding: 10px 30px;
    border-bottom: 3px solid var(--amarillo);
    display: flex;
    gap: 10px;
}
nav button { width: auto; background-color: var(--fondo); color: var(--azul-oscuro); border: 1px solid var(--azul-oscuro);}
nav button:hover { background-color: var(--amarillo); color: var(--azul-oscuro); }

main { padding: 30px; }
table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    margin-top: 15px;
}
th, td { padding: 10px; border: 1px solid #ddd; text-align: left; }
th { background-color: var(--azul-oscuro); color: white; }

.form-add { margin-bottom: 20px; background: white; padding: 15px; border-radius: 5px;}
.btn-add { background-color: var(--verde); width: 150px;}