// REEMPLAZA ESTA URL POR LA DE TU GOOGLE APPS SCRIPT
const API_URL = 'https://script.google.com/macros/s/AKfycbxrTRT6KGrG5NsuEqMIt47ju2DGpkI_U8hd4-7nkyLnZ_TJXJVg26n6ou312i4wuS2xZA/exec'; 

let currentUser = null;

document.addEventListener('DOMContentLoaded', () => {
    checkSession();

    // Eventos de botones
    document.getElementById('login-form').addEventListener('submit', handleLogin);
    document.getElementById('btn-logout').addEventListener('click', logout);
    document.getElementById('form-graduados').addEventListener('submit', saveGraduado);
    document.getElementById('form-upload').addEventListener('submit', uploadActa);

    // Sistema de pestañas
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.panel').forEach(p => p.classList.add('hidden'));
            
            e.target.classList.add('active');
            document.getElementById(e.target.dataset.target).classList.remove('hidden');
        });
    });
});

async function apiCall(data) {
    const response = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' }, // Usamos text/plain para evitar errores CORS
        body: JSON.stringify(data)
    });
    return response.json();
}

async function handleLogin(e) {
    e.preventDefault();
    const user = document.getElementById('username').value.trim();
    const pass = document.getElementById('password').value;
    const msg = document.getElementById('login-msg');

    msg.innerText = "Verificando...";
    const res = await apiCall({ action: 'login', username: user, password: pass });

    if (res.success) {
        currentUser = { username: res.username, role: res.role };
        sessionStorage.setItem('user', JSON.stringify(currentUser));
        showDashboard();
    } else {
        msg.innerText = res.message;
        msg.style.color = "red";
    }
}

function checkSession() {
    const session = sessionStorage.getItem('user');
    if (session) {
        currentUser = JSON.parse(session);
        showDashboard();
    }
}

function showDashboard() {
    document.getElementById('login-container').classList.add('hidden');
    document.getElementById('dashboard').classList.remove('hidden');
    document.getElementById('user-info').innerText = `${currentUser.username} (${currentUser.role})`;
    
    // Si es operador, autocompletar y bloquear el campo CODDANE
    if (currentUser.role === 'OPERADOR') {
        document.getElementById('g-coddane').value = currentUser.username;
        document.getElementById('g-coddane').readOnly = true;
        document.getElementById('a-coddane').value = currentUser.username;
        document.getElementById('a-coddane').readOnly = true;
    }

    loadData('Graduados', 'table-graduados');
    loadData('Actas', 'table-actas');
}

function logout() {
    sessionStorage.removeItem('user');
    location.reload();
}

async function loadData(sheetName, tableId) {
    const tbody = document.querySelector(`#${tableId} tbody`);
    tbody.innerHTML = '<tr><td colspan="10">Cargando datos...</td></tr>';

    const res = await apiCall({ 
        action: 'get_data', 
        sheet: sheetName, 
        username: currentUser.username, 
        role: currentUser.role 
    });

    if (res.success) {
        tbody.innerHTML = '';
        res.data.forEach(row => {
            let tr = document.createElement('tr');
            if (sheetName === 'Graduados') {
                tr.innerHTML = `<td>${row['MUNICIPIO']||''}</td><td>${row['CODDANE']||''}</td><td>${row['INSTITUCIÓN']||''}</td><td>${row['ESTUDIANTE']||''}</td><td>${row['TIPO DOCUMENTO']||''} - ${row['NÚMERO DOCUMENTO']||''}</td><td>${row['RESOLUCIÓN']||''}</td><td>${row['FECHA'] ? new Date(row['FECHA']).toLocaleDateString() : ''}</td>`;
            } else if (sheetName === 'Actas') {
                let pdfLink = row['PDF'] ? `<a href="${row['PDF']}" target="_blank" class="pdf-link">📄 Ver PDF</a>` : 'Sin archivo';
                tr.innerHTML = `<td>${row['NUMERO ACTA']||''}</td><td>${row['CODDANE']||''}</td><td>${pdfLink}</td>`;
            }
            tbody.appendChild(tr);
        });
    }
}

async function saveGraduado(e) {
    e.preventDefault();
    const record = {
        'MUNICIPIO': document.getElementById('g-municipio').value,
        'CODDANE': document.getElementById('g-coddane').value,
        'INSTITUCIÓN': document.getElementById('g-institucion').value,
        'ESTUDIANTE': document.getElementById('g-estudiante').value,
        'TIPO DOCUMENTO': document.getElementById('g-tipodoc').value,
        'NÚMERO DOCUMENTO': document.getElementById('g-numdoc').value,
        'RESOLUCIÓN': document.getElementById('g-resolucion').value,
        'FECHA': document.getElementById('g-fecha').value
    };

    const res = await apiCall({ action: 'add_record', sheet: 'Graduados', record: record });
    if (res.success) {
        alert('Graduado registrado correctamente');
        document.getElementById('form-graduados').reset();
        if(currentUser.role === 'OPERADOR') document.getElementById('g-coddane').value = currentUser.username;
        loadData('Graduados', 'table-graduados');
    }
}

function uploadActa(e) {
    e.preventDefault();
    const fileInput = document.getElementById('a-file');
    const numActa = document.getElementById('a-numacta').value;
    const coddane = document.getElementById('a-coddane').value;
    const msg = document.getElementById('upload-msg');
    
    if (fileInput.files.length === 0) return;
    
    const file = fileInput.files[0];
    const reader = new FileReader();
    
    msg.innerText = "Subiendo archivo, por favor espera...";
    msg.style.color = "var(--color-azul)";

    reader.onload = async function() {
        const base64String = reader.result.split(',')[1];
        const res = await apiCall({
            action: 'upload_pdf',
            filename: `Acta_${numActa}_${coddane}.pdf`,
            base64: base64String,
            coddane: coddane,
            actaNum: numActa
        });

        if (res.success) {
            msg.innerText = "¡Archivo subido con éxito!";
            msg.style.color = "var(--color-verde)";
            document.getElementById('form-upload').reset();
            if(currentUser.role === 'OPERADOR') document.getElementById('a-coddane').value = currentUser.username;
            loadData('Actas', 'table-actas');
        } else {
            msg.innerText = "Error: " + res.message;
            msg.style.color = "red";
        }
    };
    reader.readAsDataURL(file);
}
