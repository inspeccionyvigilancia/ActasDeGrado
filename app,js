const API_URL = 'TU_URL_DE_APPS_SCRIPT_AQUI'; 

let currentUser = null;
let currentRole = null;

async function apiCall(data) {
    const response = await fetch(API_URL, {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'text/plain' } // Evita problemas de CORS
    });
    return response.json();
}

async function login() {
    const user = document.getElementById('username').value;
    const pass = document.getElementById('password').value;
    const msg = document.getElementById('login-msg');
    
    msg.innerText = "Cargando...";
    const res = await apiCall({ action: 'login', username: user, password: pass });
    
    if (res.success) {
        currentUser = user;
        currentRole = res.role;
        document.getElementById('login-container').style.display = 'none';
        document.getElementById('dashboard-container').style.display = 'block';
        document.getElementById('user-info').innerText = `Hola, ${user} (${currentRole})`;
        showTab('Actas'); // Pestaña por defecto
    } else {
        msg.innerText = res.message;
        msg.style.color = 'red';
    }
}

function logout() {
    currentUser = null;
    currentRole = null;
    document.getElementById('login-container').style.display = 'block';
    document.getElementById('dashboard-container').style.display = 'none';
    document.getElementById('username').value = '';
    document.getElementById('password').value = '';
}

async function showTab(tabName) {
    const main = document.getElementById('main-content');
    main.innerHTML = `<h2>Cargando ${tabName}...</h2>`;

    if (tabName === 'Subir') {
        renderUploadForm(main);
        return;
    }

    const res = await apiCall({ action: 'getData', tabName: tabName, username: currentUser, role: currentRole });
    
    if (res.success) {
        renderTable(tabName, res.data, main);
    } else {
        main.innerHTML = `<p>Error cargando datos.</p>`;
    }
}

function renderTable(tabName, data, container) {
    let html = `<h2>Pestaña: ${tabName}</h2>`;
    
    // Formulario para agregar (visible según rol)
    html += `
        <div class="form-add">
            <h3>Agregar Nuevo Registro</h3>
            <input type="text" id="new-data-1" placeholder="Dato 1">
            <input type="text" id="new-data-2" placeholder="Dato 2">
            <button class="btn-add" onclick="addRecord('${tabName}')">Guardar</button>
        </div>
    `;

    // Renderizar Tabla
    html += `<table><thead><tr>`;
    let headers = data[0];
    headers.forEach(h => html += `<th>${h}</th>`);
    html += `</tr></thead><tbody>`;
    
    for (let i = 1; i < data.length; i++) {
        html += `<tr>`;
        for (let j = 0; j < data[i].length; j++) {
            // Si estamos en Actas y la columna se llama "PDF" o es la última, mostrar link
            if (tabName === 'Actas' && headers[j].toUpperCase() === 'PDF') {
                 html += `<td><a href="${data[i][j]}" target="_blank" style="color:#094062; font-weight:bold;">Ver PDF</a></td>`;
            } else {
                 html += `<td>${data[i][j]}</td>`;
            }
        }
        html += `</tr>`;
    }
    html += `</tbody></table>`;
    container.innerHTML = html;
}

async function addRecord(tabName) {
    // Ejemplo básico: recolectar datos. Deberás ajustarlo a tus columnas reales.
    const val1 = document.getElementById('new-data-1').value;
    const val2 = document.getElementById('new-data-2').value;
    
    // El primer campo forzamos que sea el usuario que lo creó
    const dataArray = [currentUser, val1, val2]; 
    
    alert("Guardando...");
    const res = await apiCall({ action: 'addRecord', tabName: tabName, data: dataArray });
    if(res.success) showTab(tabName);
}

function renderUploadForm(container) {
    container.innerHTML = `
        <h2>Subir Archivo PDF a Drive</h2>
        <div class="form-add">
            <input type="file" id="pdf-file" accept="application/pdf">
            <button class="btn-add" onclick="uploadPDF()">Subir a ActasDeGrado</button>
            <p id="upload-status"></p>
        </div>
    `;
}

function uploadPDF() {
    const file = document.getElementById('pdf-file').files[0];
    const status = document.getElementById('upload-status');
    if (!file) return alert("Selecciona un archivo");

    status.innerText = "Subiendo...";
    const reader = new FileReader();
    reader.onload = async function(e) {
        const base64 = e.target.result;
        const res = await apiCall({
            action: 'uploadFile',
            filename: file.name,
            fileData: base64,
            username: currentUser
        });
        
        if (res.success) {
            status.innerHTML = `<span style="color:#05b700;">Éxito.</span> <a href="${res.url}" target="_blank">Ver Archivo</a>`;
        } else {
            status.innerText = "Error: " + res.message;
        }
    };
    reader.readAsDataURL(file);
}